DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

UNIVERSITY_EMAIL_DOMAIN=iqra.edu.pk
SECRET_KEY=generate-a-long-random-string-here
FRONTEND_URL=http://localhost:5173
# Extra CORS origins (comma-separated) for local dev servers. Extends the
# always-allowed production origin; use exact origins, no wildcards.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Resend email delivery (preferred transport when RESEND_API_KEY is set).
# Placeholder only — put the real key in your deployment environment, never in git.
RESEND_API_KEY=re_placeholder_api_key
# Sender address. Default: onboarding@resend.dev (Resend test sender —
# it can only deliver to the Resend account owner's own address).
# Production to student inboxes requires a verified domain: EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
