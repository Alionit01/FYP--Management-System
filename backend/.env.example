DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME

UNIVERSITY_EMAIL_DOMAIN=iqra.edu.pk
SECRET_KEY=generate-a-long-random-string-here
FRONTEND_URL=http://localhost:5173
# Extra CORS origins (comma-separated) for local dev servers. Extends the
# always-allowed production origin; use exact origins, no wildcards.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# How many reverse proxies sit in front of the API (SEC-01).
#
# 0 (default) = no proxy assumed: X-Forwarded-For is IGNORED and the
# direct TCP peer is the login rate-limit identity. This is the safe
# value and the right one for local development.
#
# Set it to the number of hops you actually operate (e.g. 1 behind a
# single CDN/proxy). The header is then read right-to-left: the
# right-most N entries were appended by infrastructure you control, so
# the entry at position len-N is the real client. Anything left of it is
# attacker-controlled and discarded. Do NOT simply set this larger than
# your real proxy chain: with N too high a caller can still prepend a
# fake hop.
#
# Whatever this is, the ASGI server must not rewrite the client address
# independently, or the value here is meaningless. uvicorn trusts
# X-Forwarded-For from 127.0.0.1 by default (proxy_headers=True), so
# behind a local proxy run uvicorn with --no-proxy-headers or set
# FORWARDED_ALLOW_IPS= (empty) and let this setting decide.
TRUSTED_PROXY_COUNT=0
# Set this to an empty value alongside --no-proxy-headers so uvicorn
# never rewrites request.client.host from a forwarded header.
FORWARDED_ALLOW_IPS=
# Resend email delivery (preferred transport when RESEND_API_KEY is set).
# Placeholder only — put the real key in your deployment environment, never in git.
RESEND_API_KEY=re_placeholder_api_key
# Sender address. Default: onboarding@resend.dev (Resend test sender —
# it can only deliver to the Resend account owner's own address).
# Production to student inboxes requires a verified domain: EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
